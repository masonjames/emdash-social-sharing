{
  "name": "emdash-social-sharing",
  "version": "0.1.1",
  "description": "Privacy-light social sharing controls for EmDash content and themes",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/plugin.ts",
      "default": "./src/plugin.ts"
    },
    "./astro": {
      "types": "./src/astro/index.ts",
      "default": "./src/astro/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "cms",
    "plugin",
    "social-sharing",
    "sharing",
    "portable-text",
    "astro"
  ],
  "author": "Mason James",
  "license": "MIT",
  "homepage": "https://github.com/masonjames/emdash-social-sharing#readme",
  "bugs": {
    "url": "https://github.com/masonjames/emdash-social-sharing/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masonjames/emdash-social-sharing.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "pnpm test:native",
    "test:native": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm typecheck:native",
    "typecheck:native": "astro check && tsc --noEmit",
    "check:native": "pnpm typecheck:native && pnpm test:native",
    "check:marketplace": "pnpm --dir marketplace check",
    "check": "pnpm check:native && pnpm check:marketplace",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm check:native"
  },
  "peerDependencies": {
    "astro": ">=6.0.0-beta.0",
    "emdash": ">=0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^22.15.17",
    "astro": "^6.0.0-beta.0",
    "emdash": "^0.1.0",
    "tsdown": "0.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
