{
  "name": "emdash-social-sharing-marketplace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sandbox": {
      "types": "./src/sandbox-entry.ts",
      "default": "./src/sandbox-entry.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "pnpm exec emdash plugin bundle --dir . --validateOnly",
    "check": "pnpm typecheck && pnpm test && pnpm validate"
  },
  "peerDependencies": {
    "emdash": ">=0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "emdash": "^0.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.0"
  }
}
